{
  "name": "kolkative-astro-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "types": "wrangler types",
    "db:local": "wrangler d1 execute kolkative-store --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute kolkative-store --remote --file=./schema.sql",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "*",
    "typescript": "^5.9.0",
    "wrangler": "^4.40.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

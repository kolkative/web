<div id="starfield" aria-hidden="true">
  <canvas id="starfield-canvas"></canvas>
</div>

<script>
  const STAR_COUNT = 180;
  const SPEED = 0.1;

  class Star {
    x = 0;
    y = 0;
    z = 0;
    previousX = 0;
    previousY = 0;

    update(width: number, height: number) {
      this.previousX = this.x;
      this.previousY = this.y;
      this.z += SPEED * 0.0675;
      this.x += this.x * (SPEED * 0.0225) * this.z;
      this.y += this.y * (SPEED * 0.0225) * this.z;

      if (
        this.x > width / 2 ||
        this.x < -width / 2 ||
        this.y > height / 2 ||
        this.y < -height / 2
      ) {
        this.reset(width, height);
      }
    }

    reset(width: number, height: number) {
      this.x = Math.random() * width - width / 2;
      this.y = Math.random() * height - height / 2;
      this.previousX = this.x;
      this.previousY = this.y;
      this.z = 0;
    }

    draw(context: CanvasRenderingContext2D) {
      context.lineWidth = Math.max(this.z, 0.35);
      context.beginPath();
      context.moveTo(this.x, this.y);
      context.lineTo(this.previousX, this.previousY);
      context.stroke();
    }
  }

  const canvas = document.querySelector<HTMLCanvasElement>("#starfield-canvas");
  const container = document.querySelector<HTMLElement>("#starfield");
  const context = canvas?.getContext("2d");

  if (!canvas || !container || !context) {
    throw new Error("Starfield canvas could not be initialized.");
  }

  const stars = Array.from({ length: STAR_COUNT }, () => new Star());
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let animationFrame = 0;
  let width = 0;
  let height = 0;
  let pixelRatio = 1;

  function resize() {
    width = container.clientWidth;
    height = container.clientHeight;
    pixelRatio = window.devicePixelRatio || 1;
    canvas.width = Math.round(width * pixelRatio);
    canvas.height = Math.round(height * pixelRatio);
    canvas.style.width = `${width}px`;
    canvas.style.height = `${height}px`;
    context.setTransform(pixelRatio, 0, 0, pixelRatio, width * pixelRatio / 2, height * pixelRatio / 2);

    for (const star of stars) {
      star.reset(width, height);
    }

    if (reducedMotion.matches) {
      drawStaticStars();
    } else {
      cancelAnimationFrame(animationFrame);
      animationFrame = requestAnimationFrame(frame);
    }
  }

  function drawStaticStars() {
    context.clearRect(-width / 2, -height / 2, width, height);
    context.fillStyle = "white";

    for (const star of stars) {
      star.reset(width, height);
      context.fillRect(star.x, star.y, 1, 1);
    }
  }

  function frame() {
    context.fillStyle = "rgba(5, 8, 22, 0.4)";
    context.fillRect(-width / 2, -height / 2, width, height);
    context.strokeStyle = "white";

    for (const star of stars) {
      star.update(width, height);
      star.draw(context);
    }

    animationFrame = requestAnimationFrame(frame);
  }

  const resizeObserver = new ResizeObserver(resize);
  resizeObserver.observe(container);
  reducedMotion.addEventListener("change", resize);
  resize();

  document.addEventListener("astro:before-swap", () => {
    cancelAnimationFrame(animationFrame);
    resizeObserver.disconnect();
    reducedMotion.removeEventListener("change", resize);
  }, { once: true });
</script>

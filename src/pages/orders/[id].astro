---
import Base from '../../layouts/Base.astro';
const { id } = Astro.params;
---
<Base title="Order Status | KOLKATIVE STORE">
  <header class="site-header"><div class="shell header-inner"><a href="/" class="logo"><span class="logo-symbol">✳</span> KOLKATIVE<span class="logo-dot">.</span><span class="logo-small">STORE</span></a><a href="/" class="back-link">← BACK TO STORE</a></div></header>
  <main class="status-page shell"><div class="eyebrow"><span class="eyebrow-line"></span> ORDER TRACKING / MAYAR CHECKOUT</div><div class="status-shell"><div class="status-icon" id="status-icon">↗</div><span class="status-label">ORDER <span id="order-id">#{id?.slice(0,8).toUpperCase()}</span></span><h1 id="status-heading">CHECKING<br/><em>YOUR ORDER.</em></h1><p id="status-description">Sedang menghubungi Mayar untuk memastikan status pembayaran. Ini tidak otomatis berarti pembayaran sudah lunas.</p><div class="status-progress"><div></div></div><div id="status-items"></div><div class="status-summary"><span>AMOUNT</span><strong id="status-total">...</strong></div><div class="status-actions"><a id="pay-again" href="#" class="primary-cta" hidden>OPEN PAYMENT PAGE ↗</a><button id="refresh-status" class="secondary-cta" type="button">CHECK AGAIN ↻</button><a href="/" class="status-home">← BACK TO SHOP</a></div><p class="status-note">Pembayaran diverifikasi langsung melalui Mayar API. Refresh jika baru selesai membayar.</p></div></main>
  <script define:vars={{ id }}>
    const format = n => new Intl.NumberFormat('id-ID', { style:'currency', currency:'IDR', maximumFractionDigits:0 }).format(n);
    const heading = document.querySelector('#status-heading');
    const description = document.querySelector('#status-description');
    const icon = document.querySelector('#status-icon');
    const button = document.querySelector('#refresh-status');
    const pay = document.querySelector('#pay-again');
    const progress = document.querySelector('.status-progress');
    let busy = false;
    async function refresh() {
      if (busy) return;
      busy = true;
      button.disabled = true;
      try {
        const response = await fetch(`/api/orders/${encodeURIComponent(id)}`, { cache: 'no-store' });
        const order = await response.json();
        if (!response.ok) throw new Error(order.error || 'Status tidak dapat dimuat');
        document.querySelector('#status-total').textContent = format(order.total);
        const safeItems = order.items || [];
        const container = document.querySelector('#status-items');
        container.replaceChildren();
        safeItems.forEach(item => {
          const row = document.createElement('div'); row.className = 'status-item';
          const name = document.createElement('span'); name.textContent = `${item.name} × ${item.qty}`;
          const price = document.createElement('span'); price.textContent = format(item.subtotal);
          row.append(name, price); container.append(row);
        });
        progress.hidden = true;
        if (order.status === 'paid') {
          icon.textContent = '✓'; icon.classList.add('paid');
          heading.innerHTML = 'PAYMENT<br/><em>CONFIRMED.</em>';
          description.textContent = 'Pembayaran kamu berhasil diverifikasi lewat Mayar. Terima kasih sudah belanja!';
          pay.hidden = true;
          localStorage.removeItem('kolkative-cart-v1');
        } else if (order.status === 'expired' || order.status === 'failed') {
          icon.textContent = '!';
          heading.innerHTML = 'ORDER<br/><em>NOT PAID.</em>';
          description.textContent = 'Link sudah kedaluwarsa atau pembayaran tidak berhasil. Silakan buat pesanan baru.';
          pay.hidden = true;
        } else {
          icon.textContent = '↗';
          heading.innerHTML = 'AWAITING<br/><em>PAYMENT.</em>';
          description.textContent = 'Pesanan sudah dibuat. Jika kamu telah membayar, klik CHECK AGAIN untuk verifikasi ulang.';
          if (order.paymentUrl) {
            try {
              const paymentURL = new URL(order.paymentUrl);
              if (paymentURL.protocol === 'https:') { pay.href = order.paymentUrl; pay.hidden = false; }
            } catch { /* ignore invalid URL */ }
          }
        }
      } catch (error) {
        progress.hidden = true;
        heading.innerHTML = 'STATUS<br/><em>UNAVAILABLE.</em>';
        description.textContent = error.message || 'Coba lagi sebentar.';
      } finally { busy = false; button.disabled = false; }
    }
    button.addEventListener('click', refresh);
    refresh();
  </script>
</Base>
